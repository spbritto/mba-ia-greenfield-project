  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {}
      },
      "PartUrlDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "example": "https://minio:9000/videos/..."
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "public_id": {
            "type": "string",
            "example": "aBcDeFgHiJkL"
          },
          "status": {
            "type": "string",
            "example": "draft"
          },
          "upload_id": {
            "type": "string",
            "example": "abc123..."
          },
          "part_size": {
            "type": "number",
            "example": 104857600
          },
          "total_parts": {
            "type": "number",
            "example": 1
          },
          "part_urls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlDto"
            }
          }
        },
        "required": [
          "id",
          "public_id",
          "status",
          "upload_id",
          "part_size",
          "total_parts",
          "part_urls"
        ]
      },
      "RefreshPartUrlsDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshPartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "part_urls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlDto"
            }
          }
        },
        "required": [
          "part_urls"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "public_id": {
